#!/usr/bin/env python3
"""After a merge, poll ArgoCD every 10s until its automatic sync has deployed the commit, then report health. Never syncs or refreshes. Exit 0 healthy, 2 failed, 3 not there yet.

    toolbox-watch --help
"""
import sys

sys.path.insert(0, "/opt/toolbox/lib")
import toolbox_deploy  # noqa: E402

if __name__ == "__main__":
    sys.exit(toolbox_deploy.main_watch(sys.argv[1:]))
