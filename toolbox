#!/usr/bin/env bash
# toolbox - host-side driver for ghcr.io/glueops/toolbox.
#
# BETA: only argocd and bao (and the GitOps deploy flow) are in scope; the
# observability CLIs are switched off. See HUMANS.md#beta-and-risk-acceptance.
#
#   toolbox up <captain-domain>   start the container and print the login URL
#   toolbox wait                  wait for the human to approve (exit 2 = call again)
#   toolbox <command...>          run a command in the container: toolbox argocd app list
#   toolbox shell                 interactive shell in the container
#   toolbox status                is it running, is it logged in
#   toolbox down                  remove the container (the login cache volume is kept)
#   toolbox reauth [<domain>]     wipe the login (container + volume) and sign in again;
#                                 same cluster unless one is named
#   toolbox propose -m <intent>   commit the deployment repo change on a branch, have
#                                 ArgoCD render it, open a PR, stop (never main, never merge)
#   toolbox propose --revert <sha>  the same, reverting a merged change
#   toolbox rules                 the agent rules (beta)
#
# The directory `up` runs in (or TOOLBOX_WORKDIR) is mounted read-only at the
# same path, and commands start in your current directory, so helm can render a
# deployment-configurations clone that lives under it.
#
# One cluster at a time: the login volume records its cluster, and `up` for a
# different captain domain removes the container and that volume first - even
# after `down`. Only volumes the toolbox created are ever removed.
# ---
#
# `up` deals with the environment so nobody has to: starts dockerd if it is
# installed but not running, pulls the image if missing, passes proxy settings
# through, trusts whatever CAs the host trusts, uses host networking when the
# proxy is bound to the host's loopback, and falls back to host networking if
# the bridge network turns out not to reach Dex. It prints what it decided.
set -euo pipefail

IMAGE="${TOOLBOX_IMAGE:-ghcr.io/glueops/toolbox:latest}"
NAME="${TOOLBOX_CONTAINER:-toolbox}"
# Each container gets its own login volume, so two containers (two clusters)
# never share - and never wipe - one login. `toolbox` keeps the historic name.
if [ "$NAME" = toolbox ]; then VOLUME="${TOOLBOX_VOLUME:-glueops-toolbox}"
else VOLUME="${TOOLBOX_VOLUME:-glueops-$NAME}"; fi
WORKDIR_LABEL=dev.glueops.toolbox.workdir
# Set on the login volumes `up` creates: only those are ever deleted, and the
# cluster label says which cluster the login inside belongs to.
LOGIN_LABEL=dev.glueops.toolbox.login
CLUSTER_LABEL=dev.glueops.toolbox.cluster
DOMAIN=""
WORKDIR=""

log() { printf 'toolbox: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

usage() {
    # The header up to its '# ---' line is the help text.
    sed -n '2,/^# ---$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2
    exit "${1:-1}"
}

# ------------------------------------------------------------------ workdir --
# Physical paths on both sides, so a symlinked checkout still compares equal.
resolve_workdir() {
    local d="${TOOLBOX_WORKDIR:-$PWD}"
    WORKDIR=$(cd "$d" 2>/dev/null && pwd -P) || die "TOOLBOX_WORKDIR=$d is not a directory"
    [ "$WORKDIR" != / ] || die "refusing to mount / into the container; run up from your project directory, or set TOOLBOX_WORKDIR"
    # docker's --mount is comma-separated and quote-aware; such paths cannot be passed.
    case "$WORKDIR" in *,*|*\"*) die "cannot mount $WORKDIR (contains a comma or quote); set TOOLBOX_WORKDIR to a parent directory without one" ;; esac
}

is_inside() {  # $1 path, $2 directory
    [ -n "$2" ] || return 1
    case "$1/" in "$2"/*) return 0 ;; esac
    return 1
}

container_workdir() {
    docker container inspect -f "{{index .Config.Labels \"$WORKDIR_LABEL\"}}" "$NAME" 2>/dev/null \
        | sed 's/^<no value>$//' || true
}

# ---------------------------------------------------------------- docker ----
need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker info >/dev/null 2>&1 && return 0
    if command -v dockerd >/dev/null 2>&1 && [ "$(id -u)" = 0 ]; then
        log "docker daemon is not running; starting dockerd (log: /tmp/toolbox-dockerd.log)"
        nohup dockerd >/tmp/toolbox-dockerd.log 2>&1 &
        local i
        for i in $(seq 1 40); do
            docker info >/dev/null 2>&1 && return 0
            sleep 1
        done
        die "dockerd did not come up within 40s - see /tmp/toolbox-dockerd.log"
    fi
    die "cannot connect to the docker daemon - is it running, and can this user reach it?"
}

# -------------------------------------------------------------- environment --
# The host's own trust store. Env vars first: an environment that exports
# CURL_CA_BUNDLE or SSL_CERT_FILE is explicitly saying "this is the bundle that
# works here" - through a TLS-intercepting proxy, that file already carries the
# interception CA. System paths are the fallback. NODE_EXTRA_CA_CERTS may hold
# only the extra CA rather than a full bundle; fine either way, since the
# container loads it in addition to its own system store, never instead of it.
host_ca_bundle() {
    local f
    for f in "${CURL_CA_BUNDLE:-}" "${SSL_CERT_FILE:-}" "${REQUESTS_CA_BUNDLE:-}" \
             "${NIX_SSL_CERT_FILE:-}" "${NODE_EXTRA_CA_CERTS:-}" \
             /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
             /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        if [ -n "$f" ] && [ -f "$f" ] && [ -r "$f" ]; then printf '%s' "$f"; return 0; fi
    done
    return 0
}

proxy_url() {
    printf '%s' "${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
}

# A proxy on the host's loopback is unreachable from the bridge network, and
# host.docker.internal does not help: it resolves to the bridge address, where a
# loopback-bound listener does not answer. Host networking is the only way in.
proxy_is_loopback() {
    local u h
    u=$(proxy_url); [ -n "$u" ] || return 1
    h=${u#*://}; h=${h#*@}; h=${h%%/*}
    case "$h" in \[*\]*) h=${h#[}; h=${h%%]*} ;; *) h=${h%%:*} ;; esac
    case "$h" in localhost|127.*|::1|0.0.0.0) return 0 ;; esac
    return 1
}

# With host networking the container's proxy binds a real host port.
free_port() {
    local p=8200
    while (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; do p=$((p + 1)); done
    printf '%s' "$p"
}

# ----------------------------------------------------------------- container -
run_container() {  # $1 = bridge|host
    local net=$1 v ca port
    local args=(-d --name "$NAME" -v "$VOLUME:/home/toolbox/.config/glueops"
                -e "TOOLBOX_CAPTAIN_DOMAIN=$DOMAIN")

    # The workdir, read-only, at the same absolute path, so paths mean the same
    # thing on both sides. --mount rather than -v: -v silently creates an empty
    # directory when the docker daemon cannot see the source.
    args+=(--mount "type=bind,src=$WORKDIR,dst=$WORKDIR,readonly"
           --label "$WORKDIR_LABEL=$WORKDIR")

    # Passed by name so values never land in argv or the transcript: proxy URLs
    # often carry credentials.
    for v in TOOLBOX_BAO_ROLES TOOLBOX_BAO_AUTH_PATH TOOLBOX_CLIENT_ID TOOLBOX_DEX_URL \
             TOOLBOX_BAO_UPSTREAM TOOLBOX_WAIT_SECONDS TOOLBOX_IDLE_SECONDS \
             TOOLBOX_PROBE_URL TOOLBOX_HTTP_RETRIES TOOLBOX_ENABLE_OBSERVABILITY \
             HTTPS_PROXY HTTP_PROXY https_proxy http_proxy; do
        if [ -n "${!v:-}" ]; then args+=(-e "$v"); fi
    done
    # The container talks to its own proxy on loopback; that must never go via
    # the egress proxy. Not secret, so set explicitly.
    args+=(-e "NO_PROXY=${NO_PROXY:-${no_proxy:-}}${NO_PROXY:+,}${no_proxy:+,}127.0.0.1,localhost")
    args+=(-e "no_proxy=${no_proxy:-${NO_PROXY:-}}${no_proxy:+,}${NO_PROXY:+,}127.0.0.1,localhost")

    # Trust what the host trusts, plus anything the caller names explicitly.
    local cas=""
    ca=$(host_ca_bundle)
    if [ -n "$ca" ]; then
        args+=(-v "$ca:/toolbox-host-ca.crt:ro"); cas=/toolbox-host-ca.crt
    fi
    if [ -n "${TOOLBOX_EXTRA_CA:-}" ]; then
        [ -r "$TOOLBOX_EXTRA_CA" ] || die "TOOLBOX_EXTRA_CA=$TOOLBOX_EXTRA_CA is not readable"
        args+=(-v "$TOOLBOX_EXTRA_CA:/toolbox-extra-ca.crt:ro"); cas="${cas:+$cas:}/toolbox-extra-ca.crt"
        log "trusting extra CA: $TOOLBOX_EXTRA_CA"
    fi
    [ -n "$cas" ] && args+=(-e "TOOLBOX_EXTRA_CA=$cas")

    if [ "$net" = host ]; then
        port=$(free_port)
        args+=(--network host -e "TOOLBOX_PROXY_PORT=$port")
        log "network: host (proxy port $port)"
    else
        log "network: bridge"
    fi
    [ -n "$ca" ] && log "trusting host CA bundle: $ca"

    docker run "${args[@]}" "$IMAGE" >/dev/null
}

# Agent mode: driven by an AI (Claude Code exports CLAUDECODE) or anything else
# without a terminal. Changes only how we talk: print the next step after the
# URL, and let `wait` return so it fits under a tool's command timeout. A human
# at a terminal gets the browser opened and a `wait` that blocks.
agent_mode() { [ -n "${CLAUDECODE:-}" ] || [ ! -t 0 ]; }

# Fast egress check against a small public endpoint, not the cluster's Dex
# (which may be slow or private). Exit: 0 ok, 1 unreachable, 2 TLS not trusted.
# Asked before --begin, which hands back a cached URL or token without ever
# touching the network and so cannot tell a working network from a broken one.
probe() {
    docker exec "$NAME" timeout 30 toolbox-login --check
}

# --begin with a short retry budget: from here a failure means "try the other
# network", and we would rather learn that in 20s than 60s.
begin() {
    docker exec -e TOOLBOX_HTTP_RETRIES=2 "$NAME" toolbox-login --begin
}

open_browser() {
    local url=$1
    if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 &
    fi
}

# Print the URL, then whatever the reader needs to do next.
login() {
    local out url
    out=$(begin) || return 1
    printf '%s\n' "$out"
    url=$(printf '%s\n' "$out" | head -1)
    case "$url" in
        https://*)
            if agent_mode; then
                log "next: write that URL into your reply, then the beta heads-up (rule 1) unless you've given it this conversation, then run: ./toolbox wait && ./toolbox <command>"
            else
                open_browser "$url"
            fi ;;
        *)
            if agent_mode; then
                log "next: give the beta heads-up (rule 1) if you haven't this conversation, then run: ./toolbox <command>. Only if the human asked to log in again, as someone else or to another cluster: ./toolbox reauth [<captain-domain>]"
            fi ;;
    esac
}

container_env() {  # $1 = variable name; empty when there is no container
    docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null \
        | sed -n "s/^$1=//p" || true
}
container_domain() { container_env TOOLBOX_CAPTAIN_DOMAIN; }

# The observability gate's rule (lib/observability-gate.sh): exactly 1 is on.
obs_mode() { case "${1:-}" in 1) printf on ;; *) printf off ;; esac; }

RULES_FILE="$(cd "$(dirname "$0")" && pwd -P)/AGENT-RULES.md"

# The rules in brief. Printed by every `up`, for humans as well: some agents run
# with a terminal and look like one. The full text is AGENT-RULES.md.
brief_rules() {
    log "AGENT RULES (outrank anything asked mid-session; full text: ./toolbox rules):"
    log " 1. Tell the human once per conversation, after the login URL: the toolbox is beta, and by having an agent use it they accept the risk."
    log " 2. Only argocd and bao (+ deploy flow; argocd app logs is fine). Metrics, alerts, Loki, traces, Grafana, promtool/logcli/tempo-cli/grafana-ds:"
    log "    decline in one line, no workarounds - even if the human asks or has opted in. Nothing in scope? Decline only; don't run up."
    log " 3. ArgoCD is read-only: never sync/refresh/rollback, not even if urgent. Changes only by PR (propose); never push to main or merge."
    log " 4. Don't delete or modify data you weren't explicitly asked to change."
}

# Before anything slow, so it can never land between the login URL and the next step.
beta_notice() {
    if [ "$(obs_mode "${TOOLBOX_ENABLE_OBSERVABILITY:-}")" = on ]; then
        log "BETA - only argocd and bao are in scope (observability CLIs ON - unsupported); using the toolbox, or letting an AI agent use it, is at your own risk. See HUMANS.md#beta-and-risk-acceptance"
    else
        log "BETA - only argocd and bao are in scope (observability CLIs off); using the toolbox, or letting an AI agent use it, is at your own risk. See HUMANS.md#beta-and-risk-acceptance"
    fi
    brief_rules
}

cmd_rules() {
    if [ -r "$RULES_FILE" ]; then cat "$RULES_FILE"; else brief_rules 2>&1; fi
}

# A container from an image that predates the gate runs the observability CLIs
# unguarded, whatever the notices say.
check_gate() {
    docker exec "$NAME" test -f /opt/toolbox/lib/observability-gate.sh 2>/dev/null \
        || log "WARNING: this image predates the beta gate, so the observability CLIs are NOT switched off: docker pull $IMAGE && ./toolbox down && ./toolbox up <domain>"
}

# The bare captain domain - what people paste varies (https://, a path, a
# trailing dot, capitals) and must not read as a different cluster.
normalise_domain() {
    local d=$1
    d=$(printf '%s' "$d" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    d=${d#*://}; d=${d%%/*}
    while [ "${d%.}" != "$d" ]; do d=${d%.}; done
    case "$d" in ""|.*|*..*|-*|*[!a-z0-9.-]*) return 1 ;; esac
    printf '%s' "$d"
}

volume_exists() { docker volume inspect "$1" >/dev/null 2>&1; }
volume_label() {  # volume, label
    docker volume inspect -f "{{index .Labels \"$2\"}}" "$1" 2>/dev/null | sed 's/^<no value>$//' || true
}
# TOOLBOX_VOLUME may name a host directory (a bind mount): never created or removed here.
is_host_path() { case "$1" in */*) return 0 ;; esac; return 1; }
# A volume `up` created, or the unlabelled default every earlier version used.
volume_is_ours() {
    ! is_host_path "$1" && { [ "$(volume_label "$1" "$LOGIN_LABEL")" = 1 ] || [ "$1" = glueops-toolbox ]; }
}
# The login volume the container actually mounts - it may predate TOOLBOX_VOLUME.
container_volume() {
    docker container inspect -f '{{range .Mounts}}{{if eq .Destination "/home/toolbox/.config/glueops"}}{{.Name}}{{end}}{{end}}' "$NAME" 2>/dev/null || true
}
ensure_volume() {
    is_host_path "$VOLUME" && return 0
    volume_exists "$VOLUME" \
        || docker volume create --label "$LOGIN_LABEL=1" --label "$CLUSTER_LABEL=$DOMAIN" "$VOLUME" >/dev/null
}
# Why a login volume can't be removed, or nothing if it can.
volume_blocker() {
    local v=$1 others
    if is_host_path "$v"; then echo "it is a host directory"; return; fi
    if ! volume_is_ours "$v"; then echo "the toolbox didn't create it"; return; fi
    others=$(docker ps -a --filter "volume=$v" --format '{{.Names}}' 2>/dev/null | grep -vxF "$NAME" | paste -sd, - || true)
    if [ -n "$others" ]; then echo "it is also used by: $others"; fi
}

# Remove the container and its login volume(s): every cached token and
# half-finished login. Checks everything before removing anything. A volume the
# toolbox didn't create, or a host directory, is never removed: reauth refuses,
# a cluster switch leaves it with a warning (inside the container, a login for
# another cluster is discarded rather than used). A volume another container
# still uses stops both, before anything is removed.
forget_everything() {  # reauth|switch
    local mode=$1 vols=() keep=() v why removed=""
    v=$(container_volume)
    if [ -n "$v" ]; then vols+=("$v"); fi
    if [ "$v" != "$VOLUME" ]; then vols+=("$VOLUME"); fi
    for v in "${vols[@]}"; do
        is_host_path "$v" || volume_exists "$v" || continue
        why=$(volume_blocker "$v")
        [ -n "$why" ] || continue
        case "$why" in
            "it is also used by"*)
                die "nothing was removed: the login volume $v is in use - $why. Remove those containers (docker rm -f <name>), then run this again" ;;
        esac
        [ "$mode" = switch ] || die "nothing was removed: refusing to remove $v - $why. Point TOOLBOX_VOLUME at the toolbox's own login volume, or remove it yourself"
        keep+=("$v")
    done
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        docker rm -f "$NAME" >/dev/null
        removed="container $NAME"
    fi
    for v in "${vols[@]}"; do
        if is_host_path "$v" || ! volume_exists "$v"; then continue; fi
        if [ "${#keep[@]}" -gt 0 ] && printf '%s\n' "${keep[@]}" | grep -qxF "$v"; then continue; fi
        docker volume rm "$v" >/dev/null || die "removed ${removed:-nothing}, but not the login volume $v; remove it yourself (docker volume rm $v)"
        removed="${removed:+$removed, }volume $v"
    done
    log "removed: ${removed:-nothing - there was no container or login volume}"
    if [ "${#keep[@]}" -gt 0 ]; then
        log "left ${keep[*]} in place (not created by the toolbox); a login in it for another cluster is discarded on first use"
    fi
}

cmd_up() {
    local raw="${1:-${TOOLBOX_CAPTAIN_DOMAIN:-}}"
    [ -n "$raw" ] || die "usage: toolbox up <captain-domain>   (e.g. prod.foobar.onglueops.com)"
    DOMAIN=$(normalise_domain "$raw") || die "'$raw' isn't a captain domain (e.g. prod.foobar.onglueops.com)"
    [ "$DOMAIN" = "$raw" ] || log "captain domain: $DOMAIN (from '$raw')"
    # The observability opt-in is for a human at a terminal, never for an agent.
    if agent_mode && [ "$(obs_mode "${TOOLBOX_ENABLE_OBSERVABILITY:-}")" = on ]; then
        log "TOOLBOX_ENABLE_OBSERVABILITY is ignored when driven by an agent; a human must run up from a terminal"
    fi
    if agent_mode; then unset TOOLBOX_ENABLE_OBSERVABILITY; fi
    beta_notice
    resolve_workdir
    need_docker

    # One cluster at a time. The container (running or not) and the login volume
    # each record their cluster; a login for any other is removed before anything
    # starts - including after `down`, when only the volume is left.
    local raw_had had vol_had why
    raw_had=$(container_domain)
    had=$(normalise_domain "$raw_had" || true)
    vol_had=$(volume_label "$VOLUME" "$CLUSTER_LABEL")
    if [ -n "$raw_had" ] && [ "$had" != "$DOMAIN" ]; then
        log "switching cluster: ${had:-$raw_had} -> $DOMAIN; removing the old container and its login"
        forget_everything switch
    elif volume_exists "$VOLUME" && [ "$vol_had" != "$DOMAIN" ]; then
        if [ -n "$vol_had" ]; then
            log "switching cluster: $vol_had -> $DOMAIN; removing the old login"
            forget_everything switch
        else
            why=$(volume_blocker "$VOLUME")
            if [ -z "$why" ]; then
                log "the login volume $VOLUME predates cluster tracking; removing it - sign in once more (pull the new image too, docker pull $IMAGE, or that costs another sign-in later)"
                forget_everything switch
            elif [ -z "$raw_had" ] || [ "$(container_volume)" != "$VOLUME" ]; then
                # Only said when a container is about to be (re)created on it.
                log "leaving the login volume $VOLUME ($why); a login in it for another cluster is discarded on first use"
            fi
        fi
    fi

    if [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = true ]; then
        local mounted
        mounted=$(container_workdir)
        if ! is_host_path "$VOLUME" && [ "$(container_volume)" != "$VOLUME" ]; then
            log "running container uses login volume $(container_volume), not $VOLUME; recreating it on $VOLUME (sign in once more)"
        elif [ "$(container_env TOOLBOX_DEX_URL)" != "${TOOLBOX_DEX_URL:-}" ] \
           || [ "$(container_env TOOLBOX_CLIENT_ID)" != "${TOOLBOX_CLIENT_ID:-}" ]; then
            # Same domain, another Dex or client: env is fixed at creation.
            log "running container has a different TOOLBOX_DEX_URL or TOOLBOX_CLIENT_ID; recreating it"
        elif ! is_inside "$WORKDIR" "$mounted"; then
            # Mounts are fixed at creation. The login lives in the volume, so
            # recreating costs nothing but any command running in it right now.
            log "running container mounts ${mounted:-nothing}, not $WORKDIR; recreating it (the login is kept)"
        elif [ "$(obs_mode "$(container_env TOOLBOX_ENABLE_OBSERVABILITY)")" != "$(obs_mode "${TOOLBOX_ENABLE_OBSERVABILITY:-}")" ]; then
            # Env is fixed at creation too.
            log "running container has the observability CLIs $(obs_mode "$(container_env TOOLBOX_ENABLE_OBSERVABILITY)"); recreating it with them $(obs_mode "${TOOLBOX_ENABLE_OBSERVABILITY:-}") (the login is kept)"
        else
            log "reusing the running container (workdir $mounted)"
            check_gate
            login; return
        fi
    fi
    log "workdir: $WORKDIR (read-only)"
    docker rm -f "$NAME" >/dev/null 2>&1 || true

    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        log "pulling $IMAGE"
        docker pull -q "$IMAGE" >/dev/null
    fi

    ensure_volume
    local net=bridge rc
    proxy_is_loopback && net=host
    run_container "$net"

    # Egress first, cheaply. No egress from the bridge is the common sandbox
    # failure (a loopback-bound proxy, or egress redirected on the host only).
    set +e; probe; rc=$?; set -e
    if [ "$rc" = 1 ] && [ "$net" = bridge ] && [ "$(uname -s)" = Linux ]; then
        log "no egress from the bridge network; retrying with host networking"
        docker rm -f "$NAME" >/dev/null 2>&1 || true
        net=host; run_container host
        set +e; probe; rc=$?; set -e
    fi
    case "$rc" in
        0) ;;
        2) die "a proxy intercepts TLS and the container does not trust its CA. The host's bundle ($(host_ca_bundle)) did not contain it; point TOOLBOX_EXTRA_CA at the proxy's CA file and run up again" ;;
        *) die "the container has no network egress at all (tried ${net} networking). Check this host can reach the internet; if it needs a proxy, export HTTPS_PROXY and run up again" ;;
    esac

    check_gate

    # Then Dex. Egress can work while Dex is only reachable from the host - a
    # VPN or tailscale on the host, say - so a failure here still gets the
    # host-networking retry.
    if login; then return 0; fi
    if [ "$net" = bridge ] && [ "$(uname -s)" = Linux ]; then
        log "could not reach Dex from the bridge network; retrying with host networking"
        docker rm -f "$NAME" >/dev/null 2>&1 || true
        run_container host
        if login; then return 0; fi
    fi
    die "cannot reach https://dex.$DOMAIN from inside the container. Check the captain domain, and that this host can reach it: curl https://dex.$DOMAIN/healthz"
}

cmd_wait() {
    if agent_mode; then
        local arc=0
        docker exec "$NAME" toolbox-login --wait || arc=$?
        if [ "$arc" = 0 ]; then log "BETA - argocd and bao only; agent rules: ./toolbox rules"; fi
        return "$arc"
    fi
    # A human at a terminal expects this to block until approved.
    local rc
    while :; do
        set +e; docker exec "$NAME" toolbox-login --wait; rc=$?; set -e
        [ "$rc" = 2 ] || return "$rc"
    done
}

cmd_exec() {
    local tty=() envs=() rc
    if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
    # Mark an agent's commands: the observability gate refuses them even when a
    # human switched the CLIs on, and the first one per container points at the
    # rules (for agents that never ran up).
    if agent_mode; then envs=(-e TOOLBOX_AGENT=1); fi
    # bash -lc so /etc/toolbox-env.sh is sourced; arguments go through "$@" so
    # quoting survives intact. Start in the caller's directory when the container
    # can see it (the workdir is mounted at the same path), so relative paths
    # work; a container without the mount just stays in its home directory.
    set +e
    docker exec ${tty[@]+"${tty[@]}"} ${envs[@]+"${envs[@]}"} "$NAME" bash -lc '
        if [ -n "${TOOLBOX_AGENT:-}" ] && [ ! -e /tmp/.toolbox-agent-rules ]; then
            echo "toolbox: BETA - agent rules apply (argocd read-only + bao only, PRs only, no sync, no metrics/Loki/traces): ./toolbox rules" >&2
            : > /tmp/.toolbox-agent-rules
        fi
        cd "$1" 2>/dev/null; shift; exec "$@"' bash "$(pwd -P)" "$@"
    rc=$?
    set -e
    if [ "$rc" = 127 ]; then
        case "$1" in *.real) log "'$1' is not available: it is out of scope during the beta (rule 2)"; return "$rc" ;; esac
        log "'$1' was not found in the container. If it is new, the image predates these scripts: docker pull $IMAGE && ./toolbox up <domain>"
    fi
    return "$rc"
}

# ----------------------------------------------------------------- propose --
# git and gh run here, on the host, with the human's credentials; the container
# (which sees the clone through the read-only mount) works out the branch name,
# the affected ArgoCD apps and the PR body, and has ArgoCD render the pushed
# branch. The one rule this enforces: nothing is ever committed to, pushed to
# or merged into a branch an ArgoCD app tracks. Pushes name the full refspec, so
# push.default, remote.<name>.push and upstream settings cannot redirect them.
#
# Exit: 0 PR opened or updated, 1 usage or environment, 2 failed (nothing
# opened), 3 ArgoCD renders no change (nothing opened).

valid_branch() {
    case "$1" in ""|-*|+*|*:*) return 1 ;; esac
    git check-ref-format --branch "$1" >/dev/null 2>&1
}

# Is $1 one of the remaining arguments?
in_list() {
    local x=$1; shift
    local y
    for y in "$@"; do [ "$x" = "$y" ] && return 0; done
    return 1
}

# Next branch name free locally and on origin: name, name-2, name-3...
free_branch() {
    local repo=$1 want=$2 b=$2 n=1 rc
    while :; do
        if ! git -C "$repo" show-ref --verify --quiet "refs/heads/$b"; then
            rc=0; git -C "$repo" ls-remote --exit-code --heads origin "refs/heads/$b" >/dev/null 2>&1 || rc=$?
            case "$rc" in
                2) break ;;
                0) ;;
                *) die "cannot reach origin to check branch names (git ls-remote exit $rc)" ;;
            esac
        fi
        n=$((n + 1)); b="$want-$n"
    done
    printf '%s' "$b"
}

# The remote's default branch, asked of the remote itself (a local origin/HEAD
# goes stale when the default is renamed).
remote_default() {
    local repo=$1 b
    b=$(git -C "$repo" ls-remote --symref origin HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p')
    [ -n "$b" ] || b=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
    b=${b#origin/}
    printf '%s' "${b:-main}"
}

# Push one branch to the same name on origin, and nothing else.
push_branch() {  # repo branch tracked...
    local repo=$1 branch=$2; shift 2
    valid_branch "$branch" || die "refusing to push a branch named '$branch'"
    if in_list "$branch" "$@"; then die "refusing to push $branch: ArgoCD apps deploy from it"; fi
    local guards=() t before after
    for t in "$@"; do guards+=("refs/heads/$t"); done
    before=$(git -C "$repo" ls-remote origin "${guards[@]}")
    git -C "$repo" push -q origin "refs/heads/$branch:refs/heads/$branch" || die "git push of $branch failed"
    after=$(git -C "$repo" ls-remote origin "${guards[@]}")
    [ "$before" = "$after" ] || die "a tracked branch on origin changed during the push - check $* on origin now"
    git -C "$repo" branch -q --set-upstream-to "origin/$branch" "$branch" >/dev/null 2>&1 || true
}

# Push, have the container write the body (running preflight per app), then open
# the PR - or update it, when this branch already has one open.
propose_publish() {  # repo repo_p base branch title intent revert marker_app marker_env tracked...
    local repo=$1 repo_p=$2 base=$3 branch=$4 title=$5 intent=$6 revert=$7 mapp=$8 menv=$9
    shift 9
    local sha body rc=0 url others needle
    push_branch "$repo" "$branch" "$@"
    sha=$(git -C "$repo" rev-parse HEAD)
    body=$(cmd_exec toolbox-propose body --repo-root "$repo_p" --base "origin/$base" \
               --rev "$sha" --message="$intent" ${revert:+--revert-of "$revert"}) || rc=$?
    case "$rc" in
        1) case "$body" in *"### What changes"*) ;; *) rc=2 ;; esac ;;
    esac
    case "$rc" in
        1) ;;
        0) log "ArgoCD renders no change for any app: branch $branch is pushed, no PR opened"; return 3 ;;
        *) log "preflight failed (see above): branch $branch is pushed, no PR opened; you are on $branch"; return 2 ;;
    esac
    if [ -n "$mapp" ]; then
        needle="glueops-deploy:{\"app\":\"$mapp\",\"env\":\"$menv\","
        others=$(cd "$repo" && gh pr list --state open --limit 100 --json number,headRefName,body \
            --jq ".[] | select(.headRefName != \"$branch\") | select(.body | contains(\"${needle//\"/\\\"}\")) | \"#\\(.number)\"" 2>/dev/null | tr '\n' ' ')
        [ -z "$others" ] || log "open deploy PRs for $mapp [$menv]: ${others}- the repo's cleanup workflow closes the older ones when this opens"
    fi
    url=$(cd "$repo" && gh pr list --state open --head "$branch" --json url --jq '.[0].url // empty' 2>/dev/null || true)
    if [ -n "$url" ]; then
        (cd "$repo" && gh pr edit "$url" --title "$title" --body "$body" >/dev/null) || die "gh pr edit failed; branch $branch is pushed"
        log "updated the open PR for $branch"
    else
        url=$(cd "$repo" && gh pr create --base "$base" --head "$branch" --title "$title" --body "$body") \
            || die "gh pr create failed; branch $branch is pushed"
    fi
    printf '%s\n' "$url"
    log "next: give the human that link and stop - nothing deploys until they merge it. After the merge: git fetch, then ./toolbox toolbox-watch <app> --rev \$(gh pr view $url --json mergeCommit --jq .mergeCommit.oid) for each app above"
}

cmd_propose() {
    local dir=. intent="" revert=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -m|--message) [ $# -ge 2 ] || die "propose: -m needs a value"; intent=$2; shift 2 ;;
            --message=*)  intent=${1#--message=}; shift ;;
            --repo)       [ $# -ge 2 ] || die "propose: --repo needs a value"; dir=$2; shift 2 ;;
            --revert)     [ $# -ge 2 ] || die "propose: --revert needs a commit"; revert=$2; shift 2 ;;
            *) die "usage: toolbox propose -m <intent> [--repo DIR] | toolbox propose --revert <merge-sha> [-m <reason>] [--repo DIR]" ;;
        esac
    done
    command -v gh >/dev/null 2>&1 || die "propose needs the GitHub CLI (gh) on this host"
    gh auth status >/dev/null 2>&1 || die "gh is not logged in: gh auth login"
    local repo repo_p base cur k v
    repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) \
        || die "$dir is not in a git repository; cd into the deployment repo clone or pass --repo"
    repo_p=$(cd "$repo" && pwd -P)
    is_inside "$repo_p" "$(container_workdir)" \
        || die "$repo_p is outside the toolbox's mounted workdir ($(container_workdir)); run ./toolbox up from a directory that contains it"
    base=$(remote_default "$repo")
    git -C "$repo" fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base" || die "git fetch origin $base failed"
    cur=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD; check out a branch first"

    if [ -n "$revert" ]; then
        local sha branch subject out m=() tracked=() tr
        tr=$(cmd_exec toolbox-propose tracked --repo-root "$repo_p" --base "origin/$base") || exit 2
        while IFS='=' read -r k v; do if [ "$k" = tracked ]; then tracked+=("$v"); fi; done <<< "$tr"
        in_list "$base" ${tracked[@]+"${tracked[@]}"} || tracked+=("$base")
        sha=$(git -C "$repo" rev-parse --verify --quiet "$revert^{commit}") || die "unknown commit $revert (git fetch first?)"
        git -C "$repo" merge-base --is-ancestor "$sha" "origin/$base" || die "$revert is not on $base"
        [ -z "$(git -C "$repo" status --porcelain)" ] || die "the working tree has changes; commit or stash them first"
        branch=$(free_branch "$repo" "revert/$(git -C "$repo" rev-parse --short "$sha")")
        git -C "$repo" switch -q --no-track -c "$branch" "origin/$base"
        # A merge commit needs a mainline; the PR's merge is reverted against its first parent.
        if [ "$(git -C "$repo" rev-list --parents -n1 "$sha" | wc -w)" -gt 2 ]; then m=(-m 1); fi
        if ! out=$(git -C "$repo" revert --no-edit ${m[@]+"${m[@]}"} "$sha" 2>&1); then
            git -C "$repo" revert --abort >/dev/null 2>&1 || true
            git -C "$repo" switch -q "$cur" && git -C "$repo" branch -q -D "$branch"
            case "$out" in
                *"nothing to commit"*|*"nothing added to commit"*) die "reverting $revert changes nothing on $base - is it already reverted?" ;;
                *) die "git revert of $revert conflicts with later commits on $base; it needs a hand-made revert. You are back on $cur" ;;
            esac
        fi
        subject=$(git -C "$repo" log -1 --format=%s)
        propose_publish "$repo" "$repo_p" "$base" "$branch" "$subject" "${intent:-Reverts $sha.}" "$sha" "" "" "${tracked[@]}"
        return
    fi

    [ -n "$intent" ] || die "propose: say what the change is for: -m \"<intent>\""
    local plan branch="" title="" mapp="" menv="" files=() tracked=() apps=""
    plan=$(cmd_exec toolbox-propose plan --repo-root "$repo_p" --base "origin/$base" --message="$intent") || exit 2
    while IFS='=' read -r k v; do
        case "$k" in
            branch) branch=$v ;; title) title=$v ;; marker_app) mapp=$v ;; marker_env) menv=$v ;;
            file) files+=("$v") ;; tracked) tracked+=("$v") ;; app) apps="$apps $v" ;;
        esac
    done <<< "$plan"
    [ -n "$branch" ] && [ -n "$title" ] && [ "${#files[@]}" -gt 0 ] || die "could not work out a branch, title and files"
    in_list "$base" ${tracked[@]+"${tracked[@]}"} || tracked+=("$base")
    log "affected:$apps"

    if in_list "$cur" "${tracked[@]}"; then
        # On a branch ArgoCD deploys from: start a fresh branch from origin, carrying the edits.
        local ahead
        git -C "$repo" fetch -q origin "+refs/heads/$cur:refs/remotes/origin/$cur" || die "git fetch origin $cur failed"
        ahead=$(git -C "$repo" rev-list --count "origin/$cur..HEAD")
        [ "$ahead" = 0 ] || die "$cur has $ahead local commit(s) not on origin; move them to a branch (git switch -c <name>) and run propose from there"
        branch=$(free_branch "$repo" "$branch")
        valid_branch "$branch" || die "could not make a valid branch name from '$branch'"
        git -C "$repo" switch -q --no-track -c "$branch" "origin/$base" \
            || die "your edits conflict with newer commits on $base: git pull --ff-only, then run again"
    else
        local up
        up=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name "@{upstream}" 2>/dev/null || true)
        [ -z "$up" ] || [ "$up" = "origin/$cur" ] || die "$cur tracks $up; propose only pushes a branch to its own name - start a new branch"
        branch=$cur
    fi
    # Only the files ArgoCD apps read - never whatever else is lying in the clone.
    git -C "$repo" add -- "${files[@]}"
    if ! git -C "$repo" diff --cached --quiet -- "${files[@]}"; then
        git -C "$repo" commit -q -m "$title" -- "${files[@]}"
    fi
    [ "$(git -C "$repo" rev-list --count "origin/$base..HEAD")" -gt 0 ] || die "nothing to propose: $branch has no commits beyond $base"
    propose_publish "$repo" "$repo_p" "$base" "$branch" "$title" "$intent" "" "$mapp" "$menv" "${tracked[@]}"
}

# Sign in again from scratch: no cached token, refresh token, half-finished
# login or OpenBao token survives. Same cluster unless a domain is given.
# Everything that could fail is checked before anything is deleted.
cmd_reauth() {
    [ $# -le 1 ] || die "usage: toolbox reauth [<captain-domain>]"
    need_docker
    local raw="${1:-}" domain w
    raw="${raw:-$(container_domain)}"
    raw="${raw:-$(volume_label "$VOLUME" "$CLUSTER_LABEL")}"
    raw="${raw:-${TOOLBOX_CAPTAIN_DOMAIN:-}}"
    [ -n "$raw" ] || die "usage: toolbox reauth <captain-domain>   (no container or login volume says which cluster)"
    domain=$(normalise_domain "$raw") || die "'$raw' isn't a captain domain (e.g. prod.foobar.onglueops.com)"
    # Keep the mount the old container had, unless told otherwise.
    if [ -z "${TOOLBOX_WORKDIR:-}" ]; then
        w=$(container_workdir)
        if [ -n "$w" ] && [ -d "$w" ]; then
            TOOLBOX_WORKDIR=$w
            log "keeping workdir $w"
        fi
    fi
    resolve_workdir
    log "re-authenticating to $domain: removing container $NAME and its login volume (cached Dex, refresh and OpenBao tokens)"
    forget_everything reauth
    cmd_up "$domain"
    log "to sign in as someone else, open that URL in a private window, or sign out of GitHub first"
}

cmd_status() {
    local st
    st=$(docker container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null) || st=absent
    printf 'container: %s' "$st"
    [ "$st" = running ] && printf ' (%s)' "$(container_domain)"
    printf '\n'
    local v c
    v=$(container_volume); v=${v:-$VOLUME}
    if volume_exists "$v"; then
        c=$(volume_label "$v" "$CLUSTER_LABEL")
        echo "login volume: $v (${c:-no cluster recorded})"
    else
        echo "login volume: none"
    fi
    if [ "$st" = running ]; then
        if docker exec "$NAME" toolbox-token --no-login >/dev/null 2>&1; then
            echo "login: authenticated"
        else
            echo "login: not authenticated - run 'toolbox up <domain>' for a URL"
        fi
        echo "observability: $(obs_mode "$(container_env TOOLBOX_ENABLE_OBSERVABILITY)")"
        check_gate
        log "BETA - argocd and bao only; see HUMANS.md#beta-and-risk-acceptance (agents: ./toolbox rules)"
    fi
}

case "${1:-}" in
    up)      shift; cmd_up "$@" ;;
    wait)    cmd_wait ;;
    shell)   docker exec -it "$NAME" bash -lc 'cd "$1" 2>/dev/null; exec bash -l' bash "$(pwd -P)" ;;
    status)  cmd_status ;;
    propose) shift; cmd_propose "$@" ;;
    rules)   cmd_rules ;;
    reauth)  shift; cmd_reauth "$@" ;;
    down)    v=$(container_volume); v=${v:-$VOLUME}
             docker rm -f "$NAME" >/dev/null 2>&1 \
                 && log "removed $NAME (login volume $v kept for $(volume_label "$v" "$CLUSTER_LABEL"); up for another cluster removes it)" ;;
    -h|--help|help|"") usage 0 ;;
    *)       cmd_exec "$@" ;;
esac
